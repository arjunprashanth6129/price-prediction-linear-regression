% house.sty -- layout shared by the three papers in this series.
% Compile with Tectonic (tectonic main.tex) or XeLaTeX + BibTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{house}[2026/10/05 Working-paper layout]

% ---------------------------------------------------------------- page
\RequirePackage[letterpaper,margin=1in,headheight=14pt,headsep=18pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage[protrusion=true]{microtype}
\linespread{1.07}
\setlength{\parindent}{1.4em}
\setlength{\parskip}{0pt}
\frenchspacing
\widowpenalty=10000
\clubpenalty=10000

% ---------------------------------------------------------------- maths and tables
\RequirePackage{amsmath}
\RequirePackage{booktabs,threeparttable,array}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=4pt,leftmargin=1.6em}
\setlength{\abovetopsep}{0pt}
\renewcommand{\arraystretch}{1.12}

\definecolor{accent}{RGB}{31,90,166}
\definecolor{accentorange}{RGB}{217,112,42}
\definecolor{rule}{RGB}{90,90,90}
\definecolor{boxfill}{RGB}{243,246,251}

% ---------------------------------------------------------------- headings
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection.}{0.55em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.55em}{}
\titleformat{\subsubsection}[runin]{\normalfont\normalsize\itshape}{}{0pt}{}[.]
\titlespacing*{\section}{0pt}{2.2ex plus .8ex minus .3ex}{1.0ex}
\titlespacing*{\subsection}{0pt}{1.8ex plus .6ex minus .3ex}{0.6ex}
\titlespacing*{\subsubsection}{\parindent}{1.2ex plus .4ex}{0.5em}

% ---------------------------------------------------------------- captions
\RequirePackage[labelfont=bf,labelsep=period,font=small,skip=5pt,
                justification=justified,singlelinecheck=true]{caption}
\captionsetup[table]{position=top}
% Table notes in the style of finance journals: a justified paragraph under the
% table, set in a fixed-width box so it does not inherit the table's centring.
\newlength{\notewidth}\setlength{\notewidth}{0.92\textwidth}
\newenvironment{tablenote}{\par\vspace{5pt}\begin{minipage}{\notewidth}%
  \footnotesize\setlength{\parindent}{0pt}}{\end{minipage}\par}

% ---------------------------------------------------------------- diagrams
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,
                decorations.pathreplacing,shapes.misc}
\tikzset{
  stage/.style={draw=rule,line width=0.5pt,rounded corners=2pt,fill=boxfill,
                align=center,font=\footnotesize,inner sep=4pt,
                minimum height=1.5cm,text width=#1,
                execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  stage/.default=2.3cm,
  flow/.style={-{Latex[length=2.2mm,width=1.6mm]},line width=0.6pt,color=rule},
  note/.style={font=\scriptsize,align=center,text=black!70},
}

% ---------------------------------------------------------------- citations, links
\RequirePackage[authoryear,round]{natbib}
\setlength{\bibsep}{3pt plus 1pt}
\renewcommand{\bibfont}{\small}
\RequirePackage{xurl}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=accent,citecolor=accent,urlcolor=accent,
            pdfborder={0 0 0}}
\urlstyle{same}

% ---------------------------------------------------------------- running head
\RequirePackage{fancyhdr}
\newcommand{\shorttitle}[1]{\def\house@short{#1}}
\def\house@short{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\itshape\house@short}
\fancyhead[R]{\footnotesize\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\footnotesize\thepage}
  \renewcommand{\headrulewidth}{0pt}}

% ---------------------------------------------------------------- title block
\newcommand{\keywords}[1]{\def\house@keywords{#1}}
\newcommand{\jel}[1]{\def\house@jel{#1}}
\def\house@keywords{}\def\house@jel{}
\renewcommand{\@maketitle}{%
  \newpage\null\vskip 0.5em
  \begin{center}
    {\LARGE\bfseries\boldmath \@title \par}\vskip 1.4em
    {\large \lineskip .5em \begin{tabular}[t]{c}\@author\end{tabular}\par}
    \vskip 0.6em
    {\normalsize \@date}
  \end{center}\par\vskip 1.2em}
\renewenvironment{abstract}{%
  \begin{center}\begin{minipage}{0.86\textwidth}\small
  \noindent{\bfseries Abstract.}\ }{%
  \par\vspace{0.7em}\noindent{\itshape Keywords:} \house@keywords\par
  \noindent{\itshape JEL classification:} \house@jel
  \end{minipage}\end{center}\vspace{0.6em}}

% ---------------------------------------------------------------- small helpers
\newcommand{\rupee}{INR\,}
\newcommand{\code}[1]{\texttt{\small #1}}
\newcommand{\pp}{\,pp}
\endinput
